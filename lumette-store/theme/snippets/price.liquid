{%- comment -%}
  Params: product, use_variant (optional variant)
  Compare-at prices are shown only if the merchant has set one; never invent them.
{%- endcomment -%}
{%- liquid
  assign target = use_variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'general.sale_price' | t }}</span>
    <span class="price__sale">{{ target.price | money }}</span>
    <span class="visually-hidden">{{ 'general.regular_price' | t }}</span>
    <s>{{ target.compare_at_price | money }}</s>
  {%- else -%}
    {%- if product.price_varies and use_variant == blank -%}
      {{ 'general.from_price' | t: price: product.price_min | money }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit"><span class="visually-hidden">{{ 'general.unit_price' | t }}</span> {{ target.unit_price | money }} / {{ target.unit_price_measurement.reference_value }}{{ target.unit_price_measurement.reference_unit }}</span>
  {%- endif -%}
</div>
