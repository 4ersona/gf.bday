{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.page_of' | t: current: paginate.current_page, total: paginate.pages }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">{{ 'general.previous' | t }}</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}<span class="current" aria-current="page">{{ part.title }}</span>
      {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">{{ 'general.next' | t }}</a>{%- endif -%}
  </nav>
{%- endif -%}
