{%- comment -%}
  Optional GA4 + Google Ads hooks. OFF by default.
  Use either this OR the Google & YouTube app, never both (double-counted conversions).
  Checkout/purchase events cannot run from theme code: use tracking/custom-pixel.js
  (Settings > Customer events) for purchase. See docs/03-seo-and-ads.md.
{%- endcomment -%}
{%- if settings.tracking_enabled and settings.ga4_id != blank -%}
  {%- assign tag_id = settings.ga4_id | strip -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ tag_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
    gtag('js', new Date());
    gtag('config', {{ tag_id | json }}, { currency: {{ cart.currency.iso_code | json }} });
    {%- if settings.gads_id != blank -%}
    gtag('config', {{ settings.gads_id | strip | json }});
    {%- endif -%}
    window.lumetteTracking = {
      enabled: true,
      currency: {{ cart.currency.iso_code | json }},
      gadsId: {{ settings.gads_id | strip | json }},
      gadsAddToCartLabel: {{ settings.gads_add_to_cart_label | strip | json }}
    };
    // Grant consent from Shopify's Customer Privacy API (cookie banner / region rules).
    (function () {
      function sync() {
        var cp = window.Shopify && window.Shopify.customerPrivacy;
        if (!cp || !cp.currentVisitorConsent) return;
        var c = cp.currentVisitorConsent();
        var a = c.analytics === 'yes' ? 'granted' : 'denied';
        var m = c.marketing === 'yes' ? 'granted' : 'denied';
        gtag('consent', 'update', { analytics_storage: a, ad_storage: m, ad_user_data: m, ad_personalization: m });
      }
      document.addEventListener('visitorConsentCollected', sync);
      window.addEventListener('load', function () {
        if (window.Shopify && window.Shopify.loadFeatures) {
          window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (err) { if (!err) sync(); });
        }
      });
    })();
  </script>
  {%- if request.page_type == 'product' -%}
    <script>
      gtag('event', 'view_item', {
        currency: {{ cart.currency.iso_code | json }},
        value: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
        items: [{ item_id: {{ product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id | json }}, item_name: {{ product.title | json }}, item_brand: {{ product.vendor | json }}, item_category: {{ product.type | json }}, price: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }} }]
      });
    </script>
  {%- elsif request.page_type == 'collection' -%}
    <script>
      gtag('event', 'view_item_list', {
        item_list_id: {{ collection.handle | json }}, item_list_name: {{ collection.title | json }},
        items: [{%- for p in collection.products limit: 24 -%}{ item_id: {{ p.selected_or_first_available_variant.sku | default: p.selected_or_first_available_variant.id | json }}, item_name: {{ p.title | json }}, index: {{ forloop.index }}, price: {{ p.price | divided_by: 100.0 | json }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}]
      });
    </script>
  {%- endif -%}
{%- endif -%}
