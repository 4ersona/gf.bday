<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- style -%}
      :root { --color-bg: {{ settings.color_bg }}; --color-ink: {{ settings.color_ink }}; --color-accent: {{ settings.color_accent }}; --color-accent-hover: {{ settings.color_accent_hover }}; --color-surface: {{ settings.color_surface }}; --color-ink-soft: {{ settings.color_ink_soft }}; --color-line: {{ settings.color_line }}; --color-blush: {{ settings.color_blush }}; --color-sage: {{ settings.color_sage }}; --color-error: #A3262E; --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }}; --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }}; --font-body-weight: {{ settings.font_body.weight }}; --font-heading-weight: {{ settings.font_heading.weight }}; --body-size: {{ settings.body_size }}px; }
    {%- endstyle -%}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent" class="main" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
