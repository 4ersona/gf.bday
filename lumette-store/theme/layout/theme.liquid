<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {%- if settings.merchant_verification != blank -%}
      <meta name="google-site-verification" content="{{ settings.merchant_verification | escape }}">
    {%- endif -%}

    {%- style -%}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-surface: {{ settings.color_surface }};
        --color-blush: {{ settings.color_blush }};
        --color-ink: {{ settings.color_ink }};
        --color-ink-soft: {{ settings.color_ink_soft }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-hover: {{ settings.color_accent_hover }};
        --color-sage: {{ settings.color_sage }};
        --color-line: {{ settings.color_line }};
        --color-error: #A3262E;
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --body-size: {{ settings.body_size }}px;
      }
    {%- endstyle -%}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}
    {% render 'tracking-head' %}
  </head>

  <body class="template-{{ request.page_type | handleize }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_drawer and request.page_type != 'cart' %}
      {% section 'cart-drawer' %}
    {% endif %}
    {% section 'email-popup' %}

    <script>
      window.lumette = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }},
          root: {{ routes.root_url | json }}
        },
        cartDrawer: {{ settings.cart_drawer | json }},
        strings: {
          adding: {{ 'product.adding' | t | json }},
          added: {{ 'product.added' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }},
          cartError: {{ 'cart.update_error' | t | json }},
          estimateFmt: {{ 'product.delivery_estimate_range' | t: from: '__FROM__', to: '__TO__' | json }}
        },
        locale: {{ request.locale.iso_code | json }},
        currency: {{ cart.currency.iso_code | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
