<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      <a href="{{ routes.collections_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <ul class="grid grid--collections">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <li class="collection-tile" {{ block.shopify_attributes }}>
            <div class="card">
              <div class="card__media">
                {%- assign img = c.image | default: c.products.first.featured_image -%}
                {%- if img != blank -%}
                  {% render 'responsive-image', image: img, fallback_alt: c.title, sizes: '(min-width: 750px) 33vw, 50vw' %}
                {%- else -%}
                  <div class="card__placeholder">{% render 'icon', name: 'sparkle' %}</div>
                {%- endif -%}
              </div>
              <h3 class="card__title"><a href="{{ c.url }}">{{ c.title | escape }}</a></h3>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Featured collections",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }],
  "blocks": [{ "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }] }],
  "max_blocks": 6,
  "presets": [{ "name": "Featured collections", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
