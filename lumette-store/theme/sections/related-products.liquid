<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related" {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <ul class="grid grid--4">
          {%- for rec in recommendations.products -%}<li>{% render 'product-card', product: rec, show_second_image: true %}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 2, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
