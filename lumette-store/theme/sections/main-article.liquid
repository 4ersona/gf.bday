<article class="page-width section prose">
  <h1>{{ article.title | escape }}</h1>
  <p style="color:var(--color-ink-soft)">{{ article.published_at | time_tag: format: 'date' }}</p>
  {%- if article.image -%}{% render 'responsive-image', image: article.image, fallback_alt: article.title, sizes: '(min-width: 750px) 720px, 100vw', loading: 'eager' %}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
