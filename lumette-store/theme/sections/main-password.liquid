<div class="page-width section stack" style="max-width:32rem;text-align:center">
  <p class="wordmark">{{ settings.brand_name }}</p>
  <h1 class="h2">{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label class="field__label" for="Password">{{ 'general.log_in' | t }}</label>
    <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password" required>
    <button class="button" type="submit">{{ 'general.shop_now' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're getting the shelves ready" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The store is opening soon. Enter the password if you have been given one." }
  ]
}
{% endschema %}
