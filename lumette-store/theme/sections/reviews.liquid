{%- comment -%}
  Real reviews only. This section renders nothing for shoppers unless a reviews app block
  (Judge.me, Loox, Shopify Product Reviews, etc.) has been added to it.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="section" id="reviews" {{ section.shopify_attributes }}>
    <div class="page-width">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section"><div class="page-width"><p class="callout">Reviews: add your reviews app block here after installing it (Add block &gt; Apps). Nothing is shown to shoppers until you do, and no placeholder reviews are ever displayed.</p></div></section>
{%- endif -%}
{% schema %}
{
  "name": "Reviews (app)",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" }],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviews (app)" }]
}
{% endschema %}
