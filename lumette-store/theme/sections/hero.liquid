<section class="hero" {{ section.shopify_attributes }}>
  <div class="page-width hero__inner">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="button button--secondary" href="{{ section.settings.button2_link | default: routes.collections_url }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 440px, 90vw', widths: '440,660,880', loading: 'eager', fetchpriority: 'high', fallback_alt: section.settings.heading %}
      {%- else -%}
        {% render 'hero-art' %}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Beauty tools & accessories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty tools that make your routine easier." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Heatless curlers, brush sets, LED mirrors, gua sha, organizers and more - everything for hair, makeup and skin in one place." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop all tools" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "Browse categories" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Image (portrait, 4:5, at least 880px wide)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
