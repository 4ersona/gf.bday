<div class="page-width section" data-cart-region>
  <h1>{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <p>{{ 'cart.empty_help' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page">
      <div>
        {% render 'free-shipping-bar' %}
        <p class="form-message form-message--error" data-cart-error role="alert" hidden></p>
        {% render 'cart-lines' %}
      </div>
      <div class="cart-summary stack">
        <div class="totals"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul style="list-style:none;padding:0;margin:0">
            {%- for d in cart.cart_level_discount_applications -%}<li>{{ d.title }} (-{{ d.total_allocated_amount | money }})</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        <p style="font-size:.9rem;color:var(--color-ink-soft)">{{ 'cart.shipping_taxes' | t }}</p>
        {%- if settings.show_cart_note -%}
          <label class="field__label" for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea class="field__textarea" id="CartNote" name="note">{{ cart.note }}</textarea>
        {%- endif -%}
        <button class="button button--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        <p style="text-align:center;margin:0"><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></p>
      </div>
    </form>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
