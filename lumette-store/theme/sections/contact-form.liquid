<div class="page-width section">
  <div class="split" style="align-items:start">
    <div class="stack prose">
      <h1>{{ page.title | escape }}</h1>
      <div class="rte">{{ page.content }}</div>
      <div class="callout">{{ section.settings.note }}</div>
    </div>
    <div>
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert"><p>{{ 'contact.error' | t }}</p>
            <ul>{%- for field in form.errors -%}<li><a href="#ContactForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a></li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <div class="field"><label class="field__label" for="ContactForm-name">{{ 'contact.name' | t }}</label>
          <input class="field__input" id="ContactForm-name" name="contact[name]" type="text" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
        <div class="field"><label class="field__label" for="ContactForm-email">{{ 'contact.email' | t }}</label>
          <input class="field__input" id="ContactForm-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}></div>
        <div class="field"><label class="field__label" for="ContactForm-order">{{ 'contact.order_number' | t }}</label>
          <input class="field__input" id="ContactForm-order" name="contact[order number]" type="text" autocomplete="off"></div>
        <div class="field"><label class="field__label" for="ContactForm-body">{{ 'contact.message' | t }}</label>
          <textarea class="field__textarea" id="ContactForm-body" name="contact[body]" required>{{ form.body }}</textarea></div>
        <button class="button" type="submit" style="margin-top:1rem">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "textarea", "id": "note", "label": "Response-time note", "default": "We reply within 1-2 business days (Monday to Friday). For the fastest help with an order, include your order number." }
  ]
}
{% endschema %}
