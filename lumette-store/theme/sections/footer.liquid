<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div {{ block.shopify_attributes }}>
              <a class="wordmark" href="{{ routes.root_url }}">{{ settings.brand_name }}</a>
              <p style="margin-top:.75rem;max-width:22rem">{{ block.settings.text | escape }}</p>
              <div class="footer__social">
                {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
                {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
                {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
              </div>
            </div>
          {%- when 'menu' -%}
            <nav {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
              <h2>{{ block.settings.heading | escape }}</h2>
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
              </ul>
            </nav>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div>
          <h2>{{ 'newsletter.heading' | t }}</h2>
          {%- form 'customer', id: 'FooterNewsletter', class: 'stack' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,footer">
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ 'newsletter.error' | t }}</p>{%- endif -%}
              <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email_label' | t }}</label>
              <div class="inline-form">
                <input class="field__input" type="email" id="FooterEmail" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email_placeholder' | t }}">
                <button class="button" type="submit">{{ 'newsletter.subscribe' | t }}</button>
              </div>
              <p style="font-size:.82rem;opacity:.9">{{ 'newsletter.consent' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ 'footer.rights' | t }}</div>
      {%- if section.settings.show_localization and localization.available_countries.size > 1 or localization.available_languages.size > 1 and section.settings.show_localization -%}
        {%- form 'localization', class: 'localization' -%}
          {%- if localization.available_countries.size > 1 -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'general.country_region' | t }}</label>
            <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'general.language' | t }}</label>
            <select id="FooterLanguage" name="language_code" onchange="this.form.submit()">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          <noscript><button class="button button--secondary" type="submit">{{ 'general.update' | t }}</button></noscript>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show country and language selector", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "brand", "name": "Brand blurb", "limit": 1,
      "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "Everyday beauty tools for hair, makeup and skin." }]
    },
    {
      "type": "menu", "name": "Menu", "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
