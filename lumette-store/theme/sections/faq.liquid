<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="text-center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="faq-list accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="acc__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ accordion",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }],
  "blocks": [
    { "type": "item", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders arrive 8-18 business days after you order.</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ accordion", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
